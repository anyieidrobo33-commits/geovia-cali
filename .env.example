# Copie este archivo como .env.local y complete con los datos de su proyecto Supabase
# (Supabase → Project Settings → API). La "anon key" es pública por diseño:
# la seguridad la garantizan las políticas RLS de la base de datos.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
# Opcional: enlace al repositorio para la página "Acerca de"
VITE_REPO_URL=https://github.com/usuario/geovia-cali
