{
  "name": "geovia-cali",
  "private": true,
  "version": "1.3.0",
  "description": "GeoVía Cali — prototipo web georreferenciado (PWA) para el reporte y seguimiento de afectaciones de la malla vial de Santiago de Cali.",
  "author": "Cristian Camilo Alvarado Cardona, Anyie Tatiana Idrobo García",
  "contributors": [
    "Cristian Camilo Alvarado Cardona",
    "Anyie Tatiana Idrobo García"
  ],
  "license": "MIT",
  "keywords": [
    "cali",
    "malla vial",
    "pwa",
    "supabase",
    "postgis",
    "leaflet",
    "unad",
    "cdio"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cargar:reportes": "node scripts/cargar-reportes-campo.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@supabase/supabase-js": "^2.119.2",
    "leaflet": "1.9",
    "leaflet.heat": "^1.0.1",
    "lucide-react": "^1.76.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^31.0.1",
    "typescript": "5.8",
    "vite": "^7.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^3.2.7"
  }
}
